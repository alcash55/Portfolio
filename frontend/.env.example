# Public values only. Vite inlines every VITE_ variable into the client bundle,
# so a secret here ships to every visitor. The build fails on credential-shaped values.
# Base URL of the Go API (contact form, GitHub repos). Not a secret.
VITE_API_URL=http://localhost:8080
# PostHog project token. A write-only ingest key, safe to ship, so it is not a secret.
# Leave it empty and analytics stays off: the SDK is never downloaded. Read at build time.
VITE_POSTHOG_PROJECT_TOKEN=
# PostHog ingest host. Defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for an EU project.
VITE_POSTHOG_HOST=
