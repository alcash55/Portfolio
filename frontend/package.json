{
  "name": "portfolio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:site-stats": "node scripts/generate-site-stats.mjs",
    "build": "bun run generate:site-stats && tsc && vite build && bun run generate:sitemap",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/oxygen": "^5.0.13",
    "@fontsource/plus-jakarta-sans": "^5.0.20",
    "@fontsource/public-sans": "^5.0.18",
    "@fontsource/space-grotesk": "^5.0.18",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@posthog/react": "^1.10.5",
    "posthog-js": "^1.419.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20.14.11",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^4.1.10"
  }
}
