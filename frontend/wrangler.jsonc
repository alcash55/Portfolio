{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-website",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  // Our own entry, because the default one cannot export a `scheduled` handler.
  "main": "src/server.ts",
  "observability": { "enabled": true },
  // Keeps the Render free-plan API awake. 10 minutes sits under its 15 minute idle limit.
  "triggers": { "crons": ["*/10 * * * *"] },
}
