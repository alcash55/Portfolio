VITE_API_URL=http://localhost:8080

# PostHog analytics. Both are public values inlined into the client bundle --
# the project token is a write-only ingest key, not a secret. Leave them unset
# and analytics disables itself (see analytics.ts); nothing else changes.
VITE_POSTHOG_PROJECT_TOKEN=phc_yourprojecttoken
VITE_POSTHOG_HOST=https://us.i.posthog.com
