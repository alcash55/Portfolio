# Copy to .env for local development.
# PORT and WEBHOOK_URL are required by config.Load(); the rest are optional.
PORT=8080
WEBHOOK_URL=https://example.com/your-webhook-endpoint

# Optional. Comma-separated CORS origins. When unset, defaults to the Vite dev
# server (http://localhost:3005), vite preview, and https://alcash55.github.io.
# ALLOWED_ORIGINS=http://localhost:3005,https://alcash55.github.io

# Optional. GitHub personal access token used by GET /api/v1/projects to call
# the GitHub API. When unset, requests are sent unauthenticated (60/hr rate
# limit instead of 5000/hr) rather than failing to boot.
# GH_TOKEN=

# Optional. Comma-separated repo names (owned by alcash55) curated for the
# Projects section. When unset, defaults to:
# Little-Town,ac-composite-actions,Royalty-VS-Code-Theme,Portfolio
# PROJECT_REPOS=Little-Town,ac-composite-actions,Royalty-VS-Code-Theme,Portfolio

# Optional, but GET /api/v1/resume and /api/v1/resume/:variant return 502
# until it's set: a fine-grained GitHub PAT with read-only Contents access to
# the private alcash55/Resume repo, nothing else. Set up with
# scripts/resume-token-wizard.sh. Separate from GH_TOKEN above - see the
# comment on Config.ResumeGHToken in pkg/config/config.go for why.
# RESUME_GH_TOKEN=
