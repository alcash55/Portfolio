# Copy to .env for local development.
# PORT and WEBHOOK_URL are required by config.Load(); the rest are optional.
PORT=8080
WEBHOOK_URL=https://example.com/your-webhook-endpoint

# Optional. Loaded for future use, but nothing reads it yet.
GH_TOKEN=your_github_token

# Optional. Comma-separated CORS origins. When unset, defaults to the Vite dev
# server (http://localhost:3000), vite preview, and https://alcash55.github.io.
# ALLOWED_ORIGINS=http://localhost:3000,https://alcash55.github.io
